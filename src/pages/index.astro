---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts } from '../lib/posts';
import { SITE } from '../consts';
import { HERO, STATS, WORK, EXPERIENCE, ABOUT_PARAGRAPHS, FACTS } from '../data/profile';

const posts = (await getPosts()).slice(0, 6);
---

<BaseLayout title={SITE.title}>
	<section class="intro wrap">
		<p class="now">{HERO.now}</p>
		<h1>{HERO.headline}</h1>
		<div class="prose">
			<p>{HERO.lede}</p>
		</div>
	</section>

	<section class="section wrap" id="writing">
		<h2 class="label">Writing</h2>
		<div class="posts">
			{posts.map((post) => <PostRow post={post} />)}
		</div>
		<p class="meta" style="margin:14px 0 0">
			<a href="/writing/">All posts</a> · <a href="/rss.xml">RSS</a>
		</p>
	</section>

	<section class="section wrap" id="impact">
		<h2 class="label">Selected impact</h2>
		<div class="kv">
			{
				STATS.map((stat) => (
					<div class="row">
						<span class="k">{stat.key}</span>
						<span class="v">
							{stat.value}
							{stat.unit}
						</span>
						<span class="n">{stat.note}</span>
					</div>
				))
			}
		</div>
	</section>

	<section class="section wrap" id="work">
		<h2 class="label">Work</h2>
		<div class="entries">
			{
				WORK.map((item) => (
					<div class="item">
						<div class="head">
							<h3>{item.title}</h3>
							<span class="aside">{item.slug}</span>
						</div>
						<p>{item.blurb}</p>
						<p class="stack">{item.stack.join(' · ')}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section wrap" id="experience">
		<h2 class="label">Experience</h2>
		<div class="entries">
			{
				EXPERIENCE.map((role) => (
					<div class="item">
						<div class="head">
							<h3>{role.company}</h3>
							<span class="aside">{role.when}</span>
						</div>
						<p class="stack">{role.role}</p>
						<p>{role.summary}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section wrap" id="about">
		<h2 class="label">About</h2>
		<div class="prose" style="padding-top:18px">
			{ABOUT_PARAGRAPHS.map((para) => <p set:html={para} />)}
		</div>
		<div class="kv pairs" style="margin-top:26px">
			{
				FACTS.map((fact) => (
					<div class="row">
						<span class="k">{fact.label}</span>
						<span class="n">{fact.value}</span>
					</div>
				))
			}
		</div>
	</section>
</BaseLayout>
