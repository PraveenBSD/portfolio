---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import StatTile from '../components/StatTile.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import { getPosts } from '../lib/posts';
import { SITE } from '../consts';
import { HERO, STATS, WORK, ABOUT_PARAGRAPHS, FACTS } from '../data/profile';

const posts = (await getPosts()).slice(0, 4);
---

<BaseLayout title={SITE.title}>
	<section class="hero wrap">
		<p class="now"><span class="pip"></span>{HERO.now}</p>
		<h1>{HERO.headlineLead} <span class="grad">{HERO.headlineAccent}</span></h1>
		<p class="lede">{HERO.lede}</p>
		<div class="hero-actions">
			<a href="/writing/" class="btn btn-primary">Read the writing →</a>
			<a href="#work" class="btn btn-ghost">See the work</a>
		</div>
	</section>

	<section class="sec wrap" id="impact">
		<div class="sec-head">
			<div>
				<p class="label">Selected impact</p>
				<h2>Numbers from the last four years</h2>
			</div>
		</div>
		<div class="kpi">
			{
				STATS.map((stat) => (
					<StatTile
						label={stat.key}
						value={stat.value}
						unit={stat.unit}
						pct={stat.pct}
						basis={stat.basis}
						note={stat.note}
					/>
				))
			}
		</div>
	</section>

	<section class="sec wrap" id="experience">
		<div class="sec-head">
			<div>
				<p class="label">Experience</p>
				<h2>Eight years, three teams</h2>
			</div>
		</div>
		<CareerTimeline />
	</section>

	<section class="sec wrap" id="writing">
		<div class="sec-head">
			<div>
				<p class="label">Recent blogs</p>
				<h2>Latest from the log</h2>
			</div>
			<a class="more" href="/writing/">All posts →</a>
		</div>
		<div class="post-list">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>

	<section class="sec wrap" id="work">
		<div class="sec-head">
			<div>
				<p class="label">Work</p>
				<h2>Platforms I own or built</h2>
			</div>
		</div>
		<div class="grid-2">
			{
				WORK.map((item) => (
					<div class="card work-card">
						<span class="wc-slug">{item.slug}</span>
						<h3>{item.title}</h3>
						<p>{item.blurb}</p>
						<div class="stack">
							{item.stack.map((tech) => (
								<span class="pill">{tech}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="sec wrap" id="about">
		<div class="sec-head">
			<div>
				<p class="label">About</p>
				<h2>Who you're reading</h2>
			</div>
		</div>
		<div class="about-grid">
			<div class="prose">
				{ABOUT_PARAGRAPHS.map((para) => <p set:html={para} />)}
			</div>
			<div class="card facts">
				{
					FACTS.map((fact) => (
						<div class="row">
							<span class="k">{fact.label}</span>
							<span class="v">{fact.value}</span>
						</div>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
