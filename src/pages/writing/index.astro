---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, getTags } from '../../lib/posts';

const posts = await getPosts();
const tags = await getTags();
---

<BaseLayout
	title="Writing — Praveen B S D"
	description="Every post: platform engineering, GitOps, Kubernetes, SRE, DevSecOps, and FinOps — drawn from real platform work."
>
	<header class="page-head wrap">
		<p class="label">Archive</p>
		<h1>Writing</h1>
		<p>
			Everything, newest first. Short and specific, drawn from real work rather than trend cycles.
			<a href="/rss.xml">Subscribe via RSS</a>.
		</p>
		<div class="tag-list">
			{tags.map(({ tag, count }) => <a href={`/tags/${tag}/`}>{tag} ({count})</a>)}
		</div>
	</header>

	<div class="wrap" style="padding-top:30px">
		<div class="posts">
			{posts.map((post) => <PostRow post={post} showDescription />)}
		</div>
	</div>
</BaseLayout>
