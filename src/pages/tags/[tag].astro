---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getTags, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const tags = await getTags();
	return tags.map(({ tag }) => ({
		params: { tag },
		props: { tag, posts: posts.filter((p) => p.data.tag === tag) },
	}));
}

type Props = { tag: string; posts: Post[] };

const { tag, posts } = Astro.props;
const allTags = await getTags();
---

<BaseLayout
	title={`${tag} | Praveen B S D`}
	description={`Posts tagged ${tag}. Platform engineering writing by Praveen B S D.`}
>
	<header class="page-head wrap">
		<p class="label">Category</p>
		<h1>{tag}</h1>
		<p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} in this category.</p>
	</header>

	<div class="wrap" style="padding-top:24px">
		<div class="filters">
			<a class="filter" href="/writing/">All</a>
			{
				allTags.map(({ tag: t, count }) => (
					<a
						class="filter"
						href={`/tags/${t}/`}
						aria-current={t === tag ? 'page' : undefined}
					>
						{t}
						<span class="n">{count}</span>
					</a>
				))
			}
		</div>

		<div class="post-list">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</div>
</BaseLayout>
