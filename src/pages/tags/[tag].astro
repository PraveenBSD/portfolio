---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, getTags, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const tags = await getTags();
	return tags.map(({ tag }) => ({
		params: { tag },
		props: { tag, posts: posts.filter((p) => p.data.tag === tag) },
	}));
}

type Props = { tag: string; posts: Post[] };

const { tag, posts } = Astro.props;
const allTags = await getTags();
---

<BaseLayout
	title={`${tag} — Praveen B S D`}
	description={`Posts tagged ${tag} — platform engineering writing by Praveen B S D.`}
>
	<header class="page-head wrap">
		<p class="label">Tag</p>
		<h1>{tag}</h1>
		<p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}.</p>
		<div class="tag-list">
			{
				allTags.map(({ tag: t, count }) =>
					t === tag ? (
						<span aria-current="page">{t} ({count})</span>
					) : (
						<a href={`/tags/${t}/`}>{t} ({count})</a>
					),
				)
			}
		</div>
	</header>

	<div class="wrap" style="padding-top:30px">
		<div class="posts">
			{posts.map((post) => <PostRow post={post} showDescription />)}
		</div>
	</div>
</BaseLayout>
