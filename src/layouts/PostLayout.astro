---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: CollectionEntry<'posts'>;
	prev?: CollectionEntry<'posts'>;
	next?: CollectionEntry<'posts'>;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tag, readingTime } = post.data;

const fmt = (d: Date) =>
	d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
	title={`${title} — Praveen B S D`}
	description={description}
	type="article"
	publishedAt={pubDate}
>
	<header class="post-header wrap">
		<div class="meta">
			<time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
			<a href={`/tags/${tag}/`}>{tag}</a>
			{readingTime && <span>{readingTime}</span>}
			{updatedDate && <span>updated {fmt(updatedDate)}</span>}
		</div>
		<h1>{title}</h1>
	</header>

	<div class="wrap">
		<article class="article">
			<slot />
		</article>

		<nav class="post-footer">
			{prev ? <a href={`/writing/${prev.id}/`}>← {prev.data.title}</a> : <span />}
			{next && <a href={`/writing/${next.id}/`} style="text-align:right">{next.data.title} →</a>}
		</nav>
	</div>
</BaseLayout>
