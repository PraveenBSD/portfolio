---
/**
 * Applies the stored theme before first paint so there is no flash of the
 * wrong skin. Must stay inline and blocking in <head> — `is:inline` keeps
 * Astro from bundling and deferring it.
 *
 * No stored value means "follow the OS", which the CSS handles via
 * prefers-color-scheme, so we leave data-theme unset in that case.
 */
---

<script is:inline>
	try {
		const stored = localStorage.getItem('theme');
		if (stored === 'dark' || stored === 'light') {
			document.documentElement.dataset.theme = stored;
		}
	} catch {}
</script>
