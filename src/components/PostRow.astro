---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'posts'>;
	/** Home page lists titles only; the archive adds the summary. */
	showDescription?: boolean;
}

const { post, showDescription = false } = Astro.props;
const { title, description, pubDate, tag } = post.data;

const stamp = pubDate.toLocaleDateString('en-GB', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC',
});
---

<article class="post-item">
	<time class="date" datetime={pubDate.toISOString()}>{stamp}</time>
	<div>
		<h3><a href={`/writing/${post.id}/`}>{title}</a></h3>
		{showDescription && <p>{description}</p>}
		<a class="tag" href={`/tags/${tag}/`}>{tag}</a>
	</div>
</article>
