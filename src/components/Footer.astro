---
import { SITE, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap">
		<div class="foot-grid">
			<div>
				<div class="foot-brand">{SITE.shortTitle}</div>
				<p>
					Platform engineering, written down. Thanks for reading — subscribe via RSS to catch each
					push.
				</p>
			</div>
			<div class="foot-links">
				<div class="foot-col">
					<h4>Elsewhere</h4>
					<a href={SOCIAL.github} rel="me noopener">GitHub</a>
					<a href={SOCIAL.linkedin} rel="me noopener">LinkedIn</a>
					<a href={SOCIAL.email}>Email</a>
				</div>
				<div class="foot-col">
					<h4>Read</h4>
					<a href="/#writing">Latest posts</a>
					<a href="/writing/">Archive</a>
					<a href="/rss.xml">RSS feed</a>
				</div>
				<div class="foot-col">
					<h4>Site</h4>
					<a href="/#work">Work</a>
					<a href="/#experience">Experience</a>
					<a href="/#about">About</a>
				</div>
			</div>
		</div>
		<div class="foot-note">
			<span>&copy; {year} {SITE.shortTitle}</span>
			<span>built with Astro &middot; deployed on Cloudflare Pages</span>
		</div>
	</div>
</footer>
