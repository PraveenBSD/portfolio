---
import { SITE, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap inner">
		<span>&copy; {year} {SITE.author}</span>
		<span class="links">
			<a href={SOCIAL.github} rel="me noopener">GitHub</a>
			<a href={SOCIAL.linkedin} rel="me noopener">LinkedIn</a>
			<a href={SOCIAL.email}>Email</a>
			<a href="/rss.xml">RSS</a>
		</span>
	</div>
</footer>
