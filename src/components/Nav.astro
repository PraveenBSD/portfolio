---
import { NAV_LINKS, SITE } from '../consts';

const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="wrap inner">
		<a href="/" class="name"><span class="mark" aria-hidden="true"></span>{SITE.author}</a>
		<nav class="site-nav">
			{
				NAV_LINKS.map((link) => (
					<a
						href={link.href}
						aria-current={
							!link.href.includes('#') && path.startsWith(link.href) ? 'page' : undefined
						}
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>
