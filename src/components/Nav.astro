---
import { NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="nav">
	<div class="nav-inner">
		<a href="/" class="brand">
			<span class="dot"></span>praveen<span class="sigil">@</span><span class="path">platform</span><span
				class="sigil">:~$</span
			>
		</a>
		<div class="nav-right">
			<nav class="nav-links" id="navlinks">
				{NAV_LINKS.map((link) => <a href={link.href}>{link.label.toLowerCase()}</a>)}
				<a href="/writing/" class="nav-cta">./blog</a>
			</nav>
			<ThemeToggle />
			<button
				class="hamburger"
				id="hb"
				aria-label="Menu"
				aria-expanded="false"
				aria-controls="navlinks">≡</button
			>
		</div>
	</div>
</header>

<script>
	const hb = document.getElementById('hb');
	const nl = document.getElementById('navlinks');

	if (hb && nl) {
		hb.addEventListener('click', () => {
			const open = nl.classList.toggle('show');
			hb.setAttribute('aria-expanded', String(open));
		});
		nl.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).tagName === 'A') {
				nl.classList.remove('show');
				hb.setAttribute('aria-expanded', 'false');
			}
		});
	}
</script>
